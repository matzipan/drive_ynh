#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CHANGE URL PATH
#=================================================
if [ "$old_path" != "$new_path" ]; then
    ynh_script_progression "Updating nginx configuration..."
    ynh_config_add --template="nginx.conf" --destination="/etc/nginx/conf.d/$domain.d/$app.conf"
fi

#=================================================
# CHANGE URL DOMAIN
#=================================================
if [ "$old_domain" != "$new_domain" ]; then
    ynh_script_progression "Changing domain configuration..."
    
    # Update nginx configuration for new domain
    ynh_delete_file_checksum "/etc/nginx/conf.d/$old_domain.d/$app.conf"
    ynh_remove_nginx_config --domain="$old_domain"
    ynh_config_add --template="nginx.conf" --destination="/etc/nginx/conf.d/$new_domain.d/$app.conf"
    
    # Update environment configuration
    ynh_config_add --template="env" --destination="$install_dir/.env"
fi

#=================================================
# RESTART NGINX
#=================================================
ynh_script_progression "Reloading nginx configuration..."
ynh_systemd_action --service_name=nginx --action="reload"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Change URL for $app completed"
