[Unit]
Description=La Suite - Drive
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__INSTALL_DIR__/_build/venv/bin"
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/_build/venv/bin/gunicorn -b 127.0.0.1:__PORT_BACKEND__ drive.wsgi
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
